{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"outDir": "./dist",
		"rootDir": "..",
		// No "baseUrl": removed in TypeScript 7 (TS5102). The mappings below are
		// already tsconfig-relative, so alias resolution is unchanged.
		"paths": {
			"@/*": ["../src/*"],
			"@sms-editor/*": ["./src/*"],
			"@sms-editor": ["./src/index.ts"]
		},
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": false,
		"noEmit": true,
		"incremental": true,
		"module": "esnext",
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": ["next-env.d.ts", ".next/types/**/*.ts", "src/**/*.ts", "src/**/*.tsx", ".next/dev/types/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
